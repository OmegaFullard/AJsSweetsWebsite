<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<%@ Register TagPrefix="telerik" Namespace="Telerik.Web.UI" Assembly="Telerik.Web.UI" %>            
                    
<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AJs Sweets</title>

    <link rel="icon" href="images/favicon/favicon.ico" type="image/x-icon"/>
    <link rel="shortcut icon" type="image/x-icon" href="favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="images/favicon/apple-touch-icon.png"/>
    <link rel="icon" type="image/png" sizes="32x32" href="images/favicon/favicon-32x32.png"/>
    <link rel="icon" type="image/png" sizes="16x16" href="images/favicon/favicon-16x16.png"/>
    <link rel="manifest" href="/site.webmanifest"/>
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5"/>
    <meta name="msapplication-TileColor" content="#854bd1"/>
    <meta name="theme-color" content="#ffffff"/>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:bundlereference runat="server" path="~/Content/css" />

    <%-- Bootstrap 5 bundle includes Popper for dropdown support --%>
 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous"/>

    <link href="App_Themes/Page.css" rel="stylesheet" />
    <link href="App_Themes/dropdowns.css" rel="stylesheet" />
    <link href="App_Themes/headers.css" rel="stylesheet" />
    <link href="App_Themes/modals.css" rel="stylesheet" />
    <link href="App_Themes/pricing.css" rel="stylesheet" />
    <link href="App_Themes/sign-in.css" rel="stylesheet" />
    <link href="App_Themes/checkout.css" rel="stylesheet" />
    <link href="App_Themes/carousel.css" rel="stylesheet" />
    <link href="App_Themes/styles.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>


    <style>
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .site-wrapper {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 16px;
            box-sizing: border-box;
        }

        /* Top bar: search + cart */
        .top-bar {
            width: 100%;
            padding: 10px 0;
            border-bottom: 1px solid #dee2e6;
        }

        .top-bar-inner {
            display: flex;
            justify-content: end;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }


        /* Main content */
        .main-content {
            flex: 1;
            width: 100%;
            padding: 20px 0;
            text-align: center;
        }

        /* Footer */
        .site-footer {
            text-align: center;
            padding: 20px 0;
            border-top: 1px solid #dee2e6;
        }

        .site-footer .social-icons a {
            margin: 0 6px;
            font-size: 1.4rem;
        }

        /* Responsive adjustments */
        @media (max-width: 576px) {
            .top-bar-inner {
                flex-direction: column;
                align-items: center;
            }

            .top-bar-inner .form-control {
                width: 100%;
                max-width: 100%;
            }

            .site-wrapper {
                padding: 0 8px;
            }
        }

        @media (min-width: 577px) and (max-width: 991px) {
            .top-bar-inner .form-control {
                max-width: 180px;
            }
        }

        @media (min-width: 992px) {
            .top-bar-inner .form-control {
                max-width: 260px;
            }
        }

        .bd-placeholder-img {
            font-size: 1.125rem;
            text-anchor: middle;
            -webkit-user-select: none;
            -moz-user-select: none;
            user-select: none;
        }

        @media (min-width: 768px) {
            .bd-placeholder-img-lg {
                font-size: 3.5rem;
            }
        }

        .b-example-divider {
            width: 100%;
            height: 3rem;
            background-color: rgba(0, 0, 0, .1);
            border: solid rgba(0, 0, 0, .15);
            border-width: 1px 0;
            box-shadow: inset 0 .5em 1.5em rgba(0, 0, 0, .1), inset 0 .125em .5em rgba(0, 0, 0, .15);
        }
    </style>

    <script>
        $(document).ready(function () {
            $('#pw').keypress(function (e) {
                if (e.keyCode == 13)
                    $('#GoBtn').click();
            });
        });
    </script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
            </Scripts>
        </asp:ScriptManager>

 <div class="container-fluid py-2">
        <div class="d-flex justify-content-end align-items-center flex-wrap gap-2">
            <asp:TextBox ID="txtSearch" runat="server" CssClass="form-control" placeholder="Search..." MaxLength="100" style="max-width: 240px;"></asp:TextBox>
            <asp:Button ID="btnSearch" runat="server" Text="Search" CssClass="btn btn-outline-primary" OnClick="btnSearch_Click" />
            <!-- Shopping Cart Icon -->
            <asp:HyperLink ID="lnkCart" runat="server" NavigateUrl="~/Cart.aspx" CssClass="btn btn-outline-info position-relative" ToolTip="View Shopping Cart">
                <i class="fa fa-shopping-cart"></i> Cart
                <asp:Label ID="lblCartCount" runat="server" CssClass="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" Visible="false">
                    0
                </asp:Label>
            </asp:HyperLink>
        </div>
    </div>

               <!-- Main Navigation -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="site-wrapper w-100">
                <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false"
                    aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-center" id="mainNavbar">
                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link" href="Default.aspx">Home</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                                data-bs-toggle="dropdown" aria-expanded="false">Shop</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="Products.aspx">Products</a></li>
                                <li><a class="dropdown-item" href="Pricing.aspx">Pricing</a></li>
                                <li><a class="dropdown-item" href="Cart.aspx">Cart</a></li>
                                <li><a class="dropdown-item" href="checkout.aspx">Checkout</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                                data-bs-toggle="dropdown" aria-expanded="false">Account</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="Login.aspx">Login</a></li>
                                <li><a class="dropdown-item" href="UserRegistration.aspx">Register</a></li>
                                <li><a class="dropdown-item" href="UserViewProfile.aspx">Profile</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                                data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="AdminLogin.aspx">Admin Login</a></li>
                                <li><a class="dropdown-item" href="AdminRegistration.aspx">Admin Registration</a></li>
                                <li><a class="dropdown-item" href="CustomerMgt.aspx">Customer Management</a></li>
                                <li><a class="dropdown-item" href="EmployeeMgt.aspx">Employee Management</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                                data-bs-toggle="dropdown" aria-expanded="false">Information</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="About.aspx">About</a></li>
                                <li><a class="dropdown-item" href="Directions.aspx">Directions</a></li>
                                <li><a class="dropdown-item" href="Contact.aspx">Contact</a></li>
                                <li><a class="dropdown-item" href="EmployeeDirectory.aspx">Employees</a></li>
                                <li><a class="dropdown-item" href="SocialMedia.aspx">Social Media</a></li>
                                <li><a class="dropdown-item" href="Support.aspx">Support</a></li>
                                <li><a class="dropdown-item" href="Privacy.aspx">Privacy Policy</a></li>
                                <li><a class="dropdown-item" href="Terms.aspx">Terms and Conditions</a></li>
                            </ul>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div class="site-wrapper main-content">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-10">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
                    </asp:ContentPlaceHolder>
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder3" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </div>
        </div>

        <!-- MainContent Placeholder (for pages using MainContent) -->
        <header data-bs-theme="dark">
            <div class="collapse text-bg-dark" id="navbarHeader"></div>
            <div class="site-wrapper">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
                <hr />
                <div class="b-example-divider"></div>
            </div>
        </header>

        <!-- Footer -->
        <div class="site-footer">
            <div class="site-wrapper">
                <p><strong>Please be sure to follow us on Social Media!</strong></p>
                <a href="SocialMedia.aspx" class="btn btn-primary">Follow Us!</a>
                <br /><br />
                <div class="social-icons">
                    <a href="#" class="fa fa-facebook"></a>
                    <a href="#" class="fa fa-twitter"></a>
                    <a href="#" class="fa fa-linkedin"></a>
                    <a href="#" class="fa fa-youtube"></a>
                    <a href="#" class="fa fa-instagram"></a>
                </div>
                <br />
                <hr />
                <p>&copy; 2008- AJ's Sweets, 123 Treats Rd., Atlanta, GA 30080</p>
            </div>
        </div>
         https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js
    </form>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
</body>
</html>